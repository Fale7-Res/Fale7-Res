{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["uploads/**", "data/**", "previews/**"]
      }
    }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60, "maxBodySize": "50mb" }
  },
  "routes": [
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
